# Copy this file to .env and fill in your own values.
# NEVER put real keys in this file: it's meant to be committed to git, .env is not.

# Get this from https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Get this from https://resend.com -> API Keys
RESEND_API_KEY=re_your-key-here

# Where review emails get sent (your real inbox)
ADMIN_EMAIL=you@example.com

# Port the local server runs on (leave as-is unless it conflicts with something)
PORT=3000

# The public URL this app runs at (used to build links in emails).
# Locally this stays as-is; set it to your real public URL after deploying,
# e.g. https://portal.autowerkeit.com
BASE_URL=http://localhost:3000

# --- Separate admin site (optional; BUILD-LOG section 25) ---
# Serve the back office on its own address, Microsoft-style (admin.microsoft.com vs the
# public site). When set, admin pages + APIs ONLY answer on this host, the client site
# never does, and the admin sign-in cookie never reaches the public site.
# Locally you can try it with http://admin.localhost:3000 (browsers map *.localhost to your PC).
# ADMIN_URL=https://admin.autowerkeit.com

# --- Bare domain -> portal (optional; BUILD-LOG 25.3) ---
# autowerkeit.com and www.autowerkeit.com forward to BASE_URL automatically (same path, 301).
# Only set this to change that list (comma-separated hosts), or to "none" to switch it off.
# REDIRECT_HOSTS=autowerkeit.com,www.autowerkeit.com

# --- Phase 2 additions ---

# Get these from https://supabase.com -> your project -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" secret key here, NOT the public "anon" key.
# This key must never be exposed to the browser - it's server-side only.
SUPABASE_SERVICE_KEY=your-service-role-key

# Creates the owner admin account on first sign-in (then stored scrypt-hashed).
# At least 12 characters, mixing upper and lower case letters and a number.
ADMIN_PASSWORD=Choose-A-Long-Passphrase-2026

# --- Sign-off document ---
# Your business name as it appears on sign-off documents ("Prepared by")
COMPANY_BRAND=AutoWerke | IT

# Who emails come from. Leave unset while testing (uses Resend's shared test
# sender with your brand name). Once your domain is verified in Resend, set e.g.:
# EMAIL_FROM=AutoWerke | IT <noreply@mail.autowerkeit.com>

# Where client replies go (e.g. your Microsoft 365 inbox). Optional.
# EMAIL_REPLY_TO=services@autowerkeit.com

# --- Earnings ---
# VAT rate (%) added to amounts where VAT applies. Amounts are stored excl. VAT.
VAT_RATE=15.5

# --- Contact details (email signature + website footer) ---
BRAND_EMAIL=services@autowerkeit.com
BRAND_PHONE=+263 00 000 0000
BRAND_LOCATION=Harare, Zimbabwe
# Phone number printed in PDF headers. Leave empty to print none (BRAND_PHONE is not used on PDFs)
PDF_PHONE=
BRAND_TAGLINE=IT Support • Projects • Technical Consulting Services • Solutions

# --- Payment follow-ups ---
# Your timezone for reminder times
REMINDER_TIMEZONE=Africa/Harare
# Secret for the reminder cron endpoint (any long random string). Needed on hosts
# that sleep when idle (e.g. Render free tier) - see BUILD-LOG section 17. The cron service
# sends it in an "X-Cron-Key" header (never in the URL, where it would be logged).
# CRON_SECRET=change-me-to-a-long-random-string

# --- Domain registry passwords ---
# Encrypts clients' registrar passwords. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a safe copy: if this key is lost, stored passwords cannot be recovered.
# CREDENTIALS_KEY=

# --- Security (BUILD-LOG section 23) ---
# Keys the hashes of sign-in codes and session tokens. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_SECRET=
# Your name on the owner admin account (created from ADMIN_EMAIL + ADMIN_PASSWORD on first sign-in)
# ADMIN_NAME=Your Name

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID. Only loads for visitors who accept analytics cookies.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Invoices ---
# How clients should pay, printed on every invoice. Use \n for new lines, e.g.:
# INVOICE_PAYMENT_DETAILS=Bank: CBZ · Account name: AutoWerke IT · Account: 0000000000\nEcoCash: 077 000 0000 (AutoWerke IT)
